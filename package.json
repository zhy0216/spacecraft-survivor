{
  "name": "starwreck",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloudflare": "npm run build && wrangler dev",
    "build": "tsc && tsc -p worker/tsconfig.json && vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "test:i18n": "vitest run src/i18n",
    "cf:types": "wrangler types worker/worker-configuration.d.ts",
    "balance": "vite-node scripts/autobalance.ts"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "pixi.js": "^8.12.0",
    "tweakpane": "^4.0.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.15",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.2.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.123.0"
  }
}
